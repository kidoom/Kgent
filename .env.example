# LLM 配置（v0.1 单一配置源）
LLM_PROVIDER=openai
LLM_MODEL_ID=gpt-4o
LLM_API_KEY=your_api_key_here
LLM_BASE_URL=https://api.openai.com/v1
LLM_TIMEOUT=60
LLM_TEMPERATURE=0.0
LLM_MAX_TOKENS=

# Agent 行为
MAX_STEPS=5
MAX_HISTORY_LENGTH=50

# 搜索工具配置（默认 tavily）
SEARCH_BACKEND=tavily
TAVILY_API_KEY=your_tavily_api_key
SERPAPI_API_KEY=

# 调试配置
DEBUG=false
LOG_LEVEL=INFO
