# Kgent configuration — copy to .env and fill in your values.
# Real environment variables override values in this file.

# "heuristic" (offline, no API key needed) or "openai" (any OpenAI-compatible API)
KGENT_PROVIDER=heuristic

# Model name (e.g. deepseek-chat, gpt-4.1-mini)
KGENT_MODEL=deepseek-chat

# API key — REQUIRED when KGENT_PROVIDER=openai
KGENT_API_KEY=

# Base URL for OpenAI-compatible APIs (DeepSeek, local proxies, etc.)
KGENT_BASE_URL=https://api.deepseek.com

# Max agent loop iterations (1-32)
KGENT_MAX_STEPS=8

# Max messages kept per session (system prompt + recent tail, 4-500)
KGENT_MAX_SESSION_MESSAGES=100

# Working directory for file tools (default: current directory)
# KGENT_PROJECT_ROOT=.

# Comma-separated allowed browser origins for FastAPI CORS.
KGENT_CORS_ORIGINS=http://localhost:3000,http://localhost:5173
